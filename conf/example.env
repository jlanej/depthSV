# depthSV — example site configuration
#
#   cp conf/example.env conf/mysite.env    # conf/*.env is gitignored
#   edit conf/mysite.env
#   source conf/mysite.env
#
# Every variable here is a default for the matching command-line flag, which
# always wins. Set what your site fixes; pass the rest per run.
#
# There are deliberately no defaults pointing at a real filesystem: a path that
# exists on one machine and not another is the failure mode this pipeline has
# been bitten by before.

# --- inputs ---------------------------------------------------------------

# One absolute path per line, each a per-sample mosdepth *.regions.bed.gz.
export DSV_MANIFEST="/path/to/mosdepth.input.txt"

# Per-sample principal components. Columns: SAMPLE, PC1 ... PCn. Read by the
# correction stage (removed from the depth) AND by the analysis stage (added
# to every model, so the test conditions on what was removed).
export DSV_PCS="/path/to/svd.pcs.txt"

# Per-sample coverage. Columns: SAMPLE, AUTO_HQ_median.
export DSV_COVERAGE="/path/to/autosomal.median.txt"

# Phenotype table. Must contain SAMPLE plus every term used in your models.
# SAMPLE values must be unique — duplicates are refused, because they would
# otherwise misalign depth values against participants.
export DSV_PHENO="/path/to/phenotypes.tsv"

# Analyses to run: name <TAB> method <TAB> model [<TAB> flags]. See
# phenotypes.example.tsv.
export DSV_PHENO_MANIFEST="/path/to/analyses.tsv"

# --- outputs --------------------------------------------------------------

export DSV_JOIN_DIR="/path/to/work/join"
export DSV_MATRIX="${DSV_JOIN_DIR}/depth.matrix.txt.gz"
export DSV_CORRECTED_DIR="/path/to/work/corrected"
export DSV_RESULTS_DIR="/path/to/work/assoc"

# --- parameters -----------------------------------------------------------

# Principal components removed from the depth signal; 0 disables correction.
# The right number depends on your cohort's batch structure and size; set it
# from your own data rather than from a default.
export DSV_NDIM=16

# Per-region quality control applied at the analysis stage. A region with
# fewer complete observations, or with no variation in depth, carries no
# information and is skipped.
export DSV_MIN_OBS=100
export DSV_MIN_VARIANCE=1e-12

# A binary or survival phenotype with fewer cases (or controls / events) than
# this is refused up front. 20 is also the All of Us dissemination floor.
export DSV_MIN_CASES=20

# A region where one sample carries more than this share of the residual
# depth sum of squares is a test of one participant and is skipped.
export DSV_MAX_SHARE=0.5

# --- ploidy ---------------------------------------------------------------

# Sex per sample, so chrX/chrY are normalised by their expected copies rather
# than read as a sex indicator. Columns: SAMPLE and DSV_SEX_COL (M/F,
# male/female, or 1=male/2=female). Pseudo-autosomal regions come from the
# BED shipped for your build (conf/par.grch38.bed or conf/par.grch37.bed).
export DSV_SEX="/path/to/phenotypes.tsv"
export DSV_SEX_COL="sex"
export DSV_PAR="/path/to/depthSV/conf/par.grch38.bed"

# Floor on the log2 ratio before correction (-Inf disables).
export DSV_WINSOR_LOG2=-3

# --- parallelism ----------------------------------------------------------
#
# These tune one work unit. How many units run at once is the scheduler's
# business, not this pipeline's.

export DSV_JOBS=12        # parallel workers within a unit
export DSV_THREADS=4      # bgzip compression threads

# Samples per paste batch during the join. auto sizes it near sqrt(N), which
# keeps both the batch pastes and the final fan-in inside the open-file limit.
export DSV_BATCH_SIZE=auto

# Upper bound on lines handed to one worker. The actual number is whatever
# fits in DSV_BLOCK_BYTES, so memory stays flat as the cohort grows.
export DSV_CHUNK=2000

# GNU parallel buffers a whole block in memory, per worker.
export DSV_BLOCK_BYTES=67108864   # 64 MB

# --- HPC only -------------------------------------------------------------

# Environment modules to load before running, if the host provides `module`.
# Names differ between sites; on many clusters bgzip and tabix come from the
# htslib or samtools module. Ignored anywhere `module` does not exist, and
# purely advisory — the scripts check for the commands themselves regardless.
export DSV_MODULES="parallel R htslib"

# --- optional -------------------------------------------------------------

# Override the R drivers (for development, or a container path).
# export DSV_CORRECT_R="/path/to/R/correct.R"
# export DSV_ANALYZE_R="/path/to/R/analyze.R"
